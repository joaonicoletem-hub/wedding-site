<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin · Desi & João" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "trix", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "trix_gold_overrides", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="starfield" aria-hidden="true"></div>
    <div class="stars-layer" aria-hidden="true"></div>

    <%# Admin top bar %>
    <nav class="relative z-10 w-full border-b border-gold/30 bg-navy-deep/80">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <%= image_tag "monogram.png", alt: "Monograma", class: "h-9 w-9 object-contain" %>
          <span class="font-caps text-gold text-xs">Admin · Desi &amp; João</span>
        </div>
        <div class="flex items-center gap-5">
          <%= link_to "Dashboard", admin_root_path, class: "nav-link #{'active' if controller_name == 'dashboard'}" %>
          <%= link_to "Seções", admin_page_sections_path, class: "nav-link #{'active' if controller_name == 'page_sections'}" %>
          <%= link_to "Imagens", admin_page_images_path, class: "nav-link #{'active' if controller_name == 'page_images'}" %>
          <%= link_to "Ver site", root_path, class: "nav-link", target: "_blank" %>
        </div>
      </div>
    </nav>

    <% if flash.any? %>
      <div class="max-w-3xl mx-auto px-6 mt-4 relative z-10">
        <% flash.each do |type, msg| %>
          <div class="gold-card text-center text-gold font-serif"><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <main class="relative z-10 max-w-5xl mx-auto px-6 py-8">
      <%= yield %>
    </main>
  </body>
</html>
